<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identité « Lex-Sovereign » : bleu nuit et fond papier, les mêmes
         que le site. Une teinte différente ferait paraître l'application
         étrangère au service qu'elle ouvre. -->
    <!-- Theme de la PLATEFORME, pas d'AppCompat. Le rendu est identique
         ici — l'application n'affiche qu'un WebView plein ecran, sans
         barre d'action ni composant retro-porte — et cela permet de se
         passer entierement de la bibliotheque. -->
    <style name="Theme.ChatDocs" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#1B2A4A</item>
        <item name="android:windowBackground">#F4F2EC</item>
    </style>
</resources>
