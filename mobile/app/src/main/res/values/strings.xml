    <string name="telechargement_termine">Enregistré dans Téléchargements : %1$s</string>

    <string name="reessayer">Réessayer</string>

    <!-- Un certificat refusé et une absence de réseau donnaient le même
         écran. Les distinguer évite d'envoyer quelqu'un vérifier sa
