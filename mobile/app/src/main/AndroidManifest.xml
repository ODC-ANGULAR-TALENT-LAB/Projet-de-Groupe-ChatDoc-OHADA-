<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le seul droit demandé, et il est indispensable : l'application
         n'affiche rien d'autre qu'un site distant. Ne rien demander de
         plus est ce qui permet à quelqu'un d'installer sans hésiter un
         APK reçu hors magasin. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Uniquement pour Android 9 et anterieur, et uniquement pour
         deposer un export PDF dans le dossier Telechargements. A partir
         d'Android 10 le stockage cloisonne rend ce droit inutile : on
         passe par MediaStore, qui n'en demande aucun. Le plafonner ici
         evite qu'un telephone recent affiche une demande de permission
         que l'application n'utiliserait jamais. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/nom_application"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatDocs"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ActivitePrincipale"
            android:exported="true"
            android:label="@string/nom_application"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
