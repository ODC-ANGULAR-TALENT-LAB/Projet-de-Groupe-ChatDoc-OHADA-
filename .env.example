# =====================================================================
# ChatDocs OHADA - variables d'environnement
#
# A copier en .env :  copy .env.example .env   (Windows)
# Le fichier .env est dans .gitignore et ne doit JAMAIS etre commite.
# Une cle d'API publiee sur GitHub est revoquee en quelques heures,
# et parfois utilisee avant.
# =====================================================================

# --- Base de donnees -------------------------------------------------
# Doit correspondre aux identifiants de docker-compose.yml.
# Port 5435 et non 5432 : sur la machine de developpement, 5432 est pris
# par un PostgreSQL 17 en service Windows et 5433/5434 par d'autres
# conteneurs. Si tes ports sont libres, repasse a 5432 ici ET dans
# docker-compose.yml.
DATABASE_URL=postgresql://chatdocs:chatdocs_local@localhost:5435/chatdocs

# --- Fournisseur LLM (phase E) ---------------------------------------
# La cle reste cote serveur : le frontend n'appelle jamais le
# fournisseur directement.
LLM_API_KEY=votre_cle_ici
# Nom exact du modele chez votre fournisseur. Tant qu'il vaut
# "nom_du_modele", le produit se considere sans fournisseur et repond
# sans synthese : la recherche et la bibliotheque restent utilisables.
LLM_MODELE=nom_du_modele
LLM_MAX_TOKENS=4096
# Niveau d'effort : low, medium, high, xhigh, max.
# "low" tient la cible des 10 secondes du cahier des charges ; monter
# d'un cran ameliore les questions multi-articles au prix de la latence.
LLM_EFFORT=low

# --- Fournisseur d'embeddings (phase B) ------------------------------
# Utilise hors ligne par ingestion/4_vectoriser.py, jamais pendant
# qu'un utilisateur attend une reponse.
# EMBEDDING_DIMENSIONS doit correspondre au VECTOR(n) du schema SQL :
# changer de modele impose de changer les deux, et de tout revectoriser.
EMBEDDING_URL=https://api.exemple.com/v1/embeddings
EMBEDDING_MODELE=nom_du_modele_embeddings
EMBEDDING_DIMENSIONS=1536
# Laisser vide pour reutiliser LLM_API_KEY.
EMBEDDING_API_KEY=

# --- Authentification (phase G) --------------------------------------
# JWT_SECRET : chaine aleatoire longue, differente en production.
JWT_SECRET=chaine_aleatoire_longue
# Duree de session, en minutes. 720 = 12 h, soit une journee de travail :
# on lit un acte uniforme et on redige sans etre coupe. Abaisser cette
# valeur si le produit accueille un jour des donnees de dossier client.
JWT_EXPIRATION_MINUTES=720

# --- Connexion Google -------------------------------------------------
# Le client ID est public : il identifie l'application aupres de Google
# et figure aussi dans le frontend.
GOOGLE_CLIENT_ID=votre_client_id.apps.googleusercontent.com
# Le code secret n'est PAS utilise par le flux actuel (verification du
# jeton d'identite). Il ne servirait qu'au flux "code d'autorisation",
# pour agir sur les API Google au nom de l'utilisateur.
GOOGLE_CLIENT_SECRET=

# --- CORS et securite (phases F et H) --------------------------------
# Origines autorisees, separees par des virgules. En production :
# le seul domaine du frontend, en HTTPS.
ORIGINES_AUTORISEES=http://localhost:4200

# Passer a true sur l'hebergement : active HSTS et masque le diagnostic
# detaille de /sante. Laisser false en local, sinon le navigateur forcera
# localhost en HTTPS et l'API deviendra injoignable.
PRODUCTION=false

# --- Pipeline RAG (phases C et E) ------------------------------------
# SEUIL_PERTINENCE : en dessous, l'assistant refuse de repondre sans
# appeler le LLM. Valeur provisoire : elle sera calibree avec des
# donnees en phase C, jamais au jugement.
SEUIL_PERTINENCE=0.55
# Nombre d'articles envoyes au modele en contexte.
NB_ARTICLES_CONTEXTE=8

# --- Forfaits et encaissement ----------------------------------------
# COUT_QUESTION_FCFA : cout variable moyen d'une question (modele +
# embedding). C'est le seul chiffre dont depend le dimensionnement des
# forfaits, et un test refuse toute grille dont la marge tomberait sous
# 50 %. VERIFIEZ-LE CONTRE LA FACTURE REELLE DU FOURNISSEUR avant
# d'ouvrir les paiements.
COUT_QUESTION_FCFA=25

# CamPay : encaissement Mobile Money (MTN MoMo, Orange Money).
# Identifiants de l'APPLICATION marchande, jamais ceux d'un utilisateur.
# Laisser vide desactive le paiement en ligne : l'interface bascule sur
# une demande que l'administrateur valide apres reglement hors ligne.
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Cle de signature des rappels. SANS ELLE, LE RAPPEL EST REFUSE : l'URL
# est publique, et un faux « SUCCESSFUL » suffirait a s'offrir un
# abonnement.
CAMPAY_WEBHOOK_CLE=
# "demo" ne debite personne. Passer a "prod" seulement apres essais.
CAMPAY_ENVIRONNEMENT=demo
