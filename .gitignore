.env
.env.*
!.env.example

# --- Python -------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Node / Angular (phase F) -------------------------------------
node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# --- Corpus et fichiers sources (phase B) -------------------------
