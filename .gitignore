# --- Secrets : ne JAMAIS commiter ---------------------------------
.env
.env.*
!.env.example

# --- Python -------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Node / Angular (phase F) -------------------------------------
node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*

# --- Corpus et fichiers sources (phase B) -------------------------
# Les PDF officiels et les textes extraits sont volumineux et se
# retelechargent depuis leur source ; seule la fiche de provenance
# (.provenance.json) est suivie par Git.
sources/*
!sources/*.provenance.json
backend/ingestion/sortie/

# --- Donnees Docker -----------------------------------------------
pgdata/

# --- Outils et systeme --------------------------------------------
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Journaux du serveur de developpement (voir backend/scripts/demarrer_api.ps1)
backend/journal-api*.log

# Sorties de l'outil de mesure responsive (frontend/outils) : le profil
# du navigateur sans tête, le relevé de la dernière campagne et les
# captures. Tout se régénère à chaque exécution ; le versionner ferait un
# conflit à chaque mesure sans rien apprendre à personne. Les captures
# portent le nom passé à capturer.py, d'où le motif sur l'extension
# plutôt qu'une liste de fichiers.
frontend/outils/.profil-chrome/
frontend/outils/constats-responsive.json
frontend/outils/*.png
